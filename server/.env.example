DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3001
CLIENT_ORIGIN=http://localhost:5174
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mashtronics?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
ADMIN_PASSWORD=change-me
ADMIN_ORIGIN=http://localhost:5175
# SecureWatch app JWTs are verified against Supabase's published JWKS
# (see server/middleware/clientAuth.js) — no shared secret needed.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-in-production

# Self-service invite delivery (server/routes/appAuth.js request-invite route)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me-in-production
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me-in-production
SMTP_FROM=techsupport@mashtronicsbe.co.za

# Dahua device-credential encryption (server/services/deviceCredentials.js)
# 64-char hex string (32 bytes) — generate via: openssl rand -hex 32
DAHUA_CREDENTIALS_KEY=change-me-in-production

# Dahua DoLynk Developer product credentials (Open ARC — server/services/dahua.js)
DAHUA_ACCESS_KEY=change-me-in-production
DAHUA_SECRET_ACCESS_KEY=change-me-in-production
DAHUA_API_DOMAIN=https://open-api-fk.dolynkcloud.com
# Numeric Product ID from the DoLynk console product page — required as the
# ProductId header on every Open API call (PRM0010 error without it)
DAHUA_PRODUCT_ID=change-me-in-production

# Dahua Open ARC account (registered ARC company, not the DoLynk developer login)
DAHUA_ARC_EMAIL=techsupport@mashtronicsbe.co.za
DAHUA_ARC_PASSWORD=change-me-in-production
DAHUA_ARC_COMPANY_ID=change-me-in-production

# Shared secret embedded in the callback URL path registered with Dahua's
# setCallbackConfig (server/routes/dahuaCallback.js) — there's no documented
# inbound signature scheme for Open ARC pushes, so this is the only gate.
# Generate via: openssl rand -hex 32
DAHUA_CALLBACK_TOKEN=change-me-in-production
