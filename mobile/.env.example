# Copy to .env (gitignored) and fill in.
#
# EXPO_PUBLIC_API_URL: the Express server (server/, port 3001). When testing
# in Expo Go on a physical phone, "localhost" points at the PHONE — use this
# PC's LAN IP instead (run `ipconfig`, use the IPv4 address, e.g.
# http://192.168.1.23:3001). Phone and PC must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Supabase project (same one as server/.env SUPABASE_URL). The anon/publishable
# key is safe to ship in the app; NEVER put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://rwciqohwfpkdyenklbkf.supabase.co
